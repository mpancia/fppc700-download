#search-form {
    padding: 1 2;
}

.field {
    height: auto;
    margin-bottom: 1;
}

.field Label {
    color: $text-muted;
}

#search-flags {
    height: auto;
    margin-bottom: 1;
}

#search-flags Checkbox {
    margin-right: 2;
}

#search-button {
    width: auto;
}

#results-table {
    height: 12;
    margin-top: 1;
}

#download-all-button {
    width: auto;
    margin-top: 1;
}

#download-progress {
    height: auto;
    margin-top: 1;
}

#download-log {
    height: 10;
    border: solid $primary;
    margin-top: 1;
}
